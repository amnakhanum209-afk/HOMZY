
generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(cuid())
  firstName           String
  lastName            String
  email               String                @unique
  phone               String
  password            String
  role                Role                  @default(TENANT)
  isOwner             Boolean               @default(false)
  createdAt           DateTime              @default(now())
  properties          Property[]
  ownerRequest        OwnerRequest?
  passwordResetTokens PasswordResetToken[]
  tenantBookings      VisitBooking[]
  conversations       Conversation[]
}

model Property {
  id              String            @id @default(cuid())
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id])
  title           String
  description     String
  propertyType    PropertyType
  imageUrl        String?
  imageUrls       String[]          @default([])
  listingType     String
  address         String
  locality        String
  city            String
  state           String
  country         String
  pincode         String
  latitude        Float?
  longitude       Float?
  monthlyRent     Int
  securityDeposit Int
  area            Int
  bedrooms        Int
  bathrooms       Int
  furnishing      FurnishingType
  floor           Int?
  totalFloors     Int?
  parking         Boolean           @default(false)
  amenities       PropertyAmenity[]
  availableDate   DateTime?
  status          PropertyStatus    @default(PENDING)
  previousStatus  PropertyStatus?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  visitBookings   VisitBooking[]
}

model OwnerRequest {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    OwnerRequestStatus @default(PENDING)
  message   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  TENANT
  OWNER
  ADMIN
}

enum OwnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  STUDIO
  PG
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK_PLUS
  OTHER
}

enum FurnishingType {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  RENTED
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model VisitBooking {
  id         String             @id @default(cuid())
  tenantId   String
  propertyId String
  visitAt    DateTime
  message    String?
  status     VisitBookingStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant     User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

enum VisitBookingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String          @db.Text
  createdAt      DateTime        @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

enum ChatMessageRole {
  USER
  ASSISTANT
}
